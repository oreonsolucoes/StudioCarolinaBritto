{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "servicos": {
      ".read": true,
      ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('unhas').val() === true))"
    },
    "servicos_cabelo": {
      ".read": true,
      ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('cabelo').val() === true))"
    },
    "horarios_funcionamento": {
      ".read": true,
      ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('unhas').val() === true))"
    },
    "horarios_funcionamento_cabelo": {
      ".read": true,
      ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('cabelo').val() === true))"
    },
    "configuracoes": {
      "recesso": {
        ".read": true,
        ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('unhas').val() === true))"
      },
      "recesso_cabelo": {
        ".read": true,
        ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('cabelo').val() === true))"
      },
      "mensagens": {
        ".read": true,
        ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin')"
      }
    },
    "agendamentos": {
      ".read": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))",
      "$id": {
        ".write": "(!data.exists() && newData.exists() && newData.child('criadoPor').val() === 'cliente' && newData.child('cliente').val() !== 'BLOQUEADO') || (data.exists() && !newData.exists() && data.child('criadoPor').val() === 'cliente') || ((data.exists() ? data : newData).child('agendaId').val() === 'cabelo' ? ((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('cabelo').val() === true)) : ((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('unhas').val() === true)))",
        ".validate": "newData.hasChildren(['cliente','whatsapp','data','hora','duracao','servicoNome'])",
        "cliente": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "whatsapp": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8,15}$/)"
        },
        "data": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "hora": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,2}:[0-9]{2}$/)"
        },
        "duracao": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 600"
        },
        "servicoNome": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "agendaId": {
          ".validate": "newData.val() === 'unhas' || newData.val() === 'cabelo'"
        },
        "$outro": {
          ".validate": true
        }
      }
    },
    "ocupacao": {
      "$agenda": {
        "$data": {
          ".read": true,
          "$id": {
            ".write": "($agenda === 'unhas' || $agenda === 'cabelo') && $data.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && !root.child('agendamentos').child($id).exists()) || ($agenda === 'cabelo' ? ((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('cabelo').val() === true)) : ((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('unhas').val() === true))))",
            ".validate": "newData.hasChildren(['hora','duracao']) && newData.child('hora').isString() && newData.child('hora').val().matches(/^[0-9]{1,2}:[0-9]{2}$/) && newData.child('duracao').isNumber() && newData.child('duracao').val() >= 5 && newData.child('duracao').val() <= 600"
          }
        }
      }
    },
    "agendamentosPorTelefone": {
      "$tel": {
        ".read": true,
        "$id": {
          ".write": "$tel.matches(/^[0-9]{8,15}$/) && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && !root.child('agendamentos').child($id).exists()) || ((data.exists() ? data : newData).child('agendaId').val() === 'cabelo' ? ((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('cabelo').val() === true)) : ((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria' && root.child('usuarios').child(auth.uid).child('agendas').child('unhas').val() === true))))",
          ".validate": "newData.hasChildren(['data','hora']) && newData.child('data').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('hora').val().matches(/^[0-9]{1,2}:[0-9]{2}$/)"
        }
      }
    },
    "clientesBloqueados": {
      ".read": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))",
      ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))",
      "$tel": {
        ".read": true
      }
    },
    "planos": {
      ".read": true,
      ".write": "(auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin')"
    },
    "assinaturas": {
      ".read": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))",
      ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))",
      "$tel": {
        ".read": true
      }
    },
    "assinaturasPendentes": {
      ".read": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))",
      ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))"
    },
    "planoCobrancas": {
      ".read": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))",
      ".write": "((auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'admin') || (auth != null && root.child('usuarios').child(auth.uid).child('papel').val() === 'funcionaria'))"
    }
  }
}